# Recognition Provider ('audd' or 'acrcloud', default: audd)
RECOGNITION_PROVIDER=audd

# AudD Music Recognition Credentials (https://dashboard.audd.io/)
# Uses 'test' token for development (10 requests/day).
AUDD_API_TOKEN=test

# ACRCloud Music Recognition Credentials (https://www.acrcloud.com/)
ACR_HOST=
ACR_ACCESS_KEY=
ACR_ACCESS_SECRET=

